# ==========================================================
# AI Agent Configuration & API Keys
# ==========================================================

# Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model to use (default: gemini-1.5-flash or gemini-2.0-flash)
DEFAULT_LLM_MODEL=gemini-3.5-flash

# Job Search Configuration
# Set USE_MOCK_SEARCH=true for 100% reliable offline/demo execution without API limits
USE_MOCK_SEARCH=true

# Optional Live Job Search API Keys
# SerpAPI (Google Jobs endpoint): https://serpapi.com/
SERPAPI_API_KEY=
# RapidAPI (JSearch API): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
